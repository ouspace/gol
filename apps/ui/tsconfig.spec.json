{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		"module": "commonjs",
		"types": [
			"jest",
			"node"
		]
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"jest.config.ts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.tsx",
		"src/**/*.test.js",
		"src/**/*.spec.js",
		"src/**/*.test.jsx",
		"src/**/*.spec.jsx",
		"src/**/__tests__/**/*.ts",
		"src/**/__tests__/**/*.tsx",
		"src/**/__test__/**/*.ts",
		"src/**/__test__/**/*.tsx",
		"src/**/*.d.ts"
	],
	"references": [
		{
			"path": "./tsconfig.app.json"
		}
	]
}