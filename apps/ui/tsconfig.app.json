{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		"types": []
	},
	"exclude": [
		"**/*.test.ts",
		"**/*.spec.ts",
		"**/*.test.tsx",
		"**/*.spec.tsx",
		"**/*.test.js",
		"**/*.spec.js",
		"**/*.test.jsx",
		"**/*.spec.jsx",
		"**/*.stories.ts",
		"**/*.stories.js",
		"**/*.stories.jsx",
		"**/*.stories.tsx",
		"**/*.stories.mdx",
		"**/*.snippet.ts",
		"**/*.snippet.tsx",
		"**/__tests__/**",
		"**/__test__/**",
		"src/test-setup.ts",
		"postcss.config.js",
		"storybook-static"
	],
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.js",
		"**/*.jsx"
	]
}